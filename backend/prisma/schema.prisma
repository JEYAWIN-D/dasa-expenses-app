datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  FINANCE
  SALES
  STAFF
  VIEWER
}

enum QuotationStatus {
  DRAFT
  SENT
  VIEWED
  NEGOTIATION
  REVISED
  APPROVED
  REJECTED
  EXPIRED
  CONVERTED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMode {
  CASH
  BANK_TRANSFER
  UPI
  CREDIT_CARD
  DEBIT_CARD
  CHEQUE
  OTHER
}

enum PaymentType {
  ADVANCE
  PARTIAL
  FULL
  OTHER_INCOME
}

enum AssetType {
  LOGO
  SEAL
  SIGNATURE
}

model CompanyProfile {
  id                 String   @id @default(uuid())
  companyName        String
  tagline            String?
  logoUrl            String?
  sealUrl            String?
  address            String
  city               String
  state              String
  country            String   @default("India")
  postalCode         String?
  phone              String
  email              String
  website            String?
  gstNumber          String?
  panNumber          String?
  bankName           String?
  bankAccountName    String?
  bankAccountNumber  String?
  bankIfsc           String?
  bankSwift          String?
  termsAndConditions String?  @db.Text
  authorizedPerson   String?
  signatureImageUrl  String?
  signaturePinHash   String   // Hashed 4-digit PIN for signature authorization
  currency           String   @default("INR")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  assets             CompanyAsset[]
}

model CompanyAsset {
  id         String         @id @default(uuid())
  companyId  String?
  company    CompanyProfile? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type       AssetType
  name       String         // e.g. "Primary Full Logo", "Dark Mode Logo", "Official Round Stamp", "Accounts Dept Seal"
  url        String         @db.Text
  isPrimary  Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([companyId])
  @@index([type])
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role       @default(ADMIN)
  status       String     @default("ACTIVE")
  phone        String?
  avatar       String?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]

  @@index([email])
  @@index([role])
}

model Client {
  id             String          @id @default(uuid())
  clientCode     String          @unique
  companyName    String
  contactPerson  String
  email          String?
  phone          String
  alternatePhone String?
  website        String?
  address        String?
  city           String?
  state          String?
  country        String?         @default("India")
  postalCode     String?
  gstNumber      String?
  panNumber      String?
  industry       String?
  clientType     String?         @default("Corporate")
  leadSource     String?
  accountManager String?
  status         String          @default("ACTIVE")
  tags           String?
  notes          String?         @db.Text
  isDeleted      Boolean         @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  contacts       ClientContact[]
  quotations     Quotation[]
  invoices       Invoice[]
  payments       Payment[]
  projects       Project[]

  @@index([companyName])
  @@index([email])
  @@index([status])
  @@index([isDeleted])
}

model ClientContact {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  designation String?
  email       String?
  phone       String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
}

model Quotation {
  id                 String                 @id @default(uuid())
  quotationNumber    String                 @unique
  revisionNumber     Int                    @default(0)
  clientId           String
  client             Client                 @relation(fields: [clientId], references: [id])
  quotationDate      DateTime               @default(now())
  expiryDate         DateTime
  status             QuotationStatus        @default(DRAFT)
  subtotal           Float                  @default(0)
  discountRate       Float                  @default(0)
  discountAmount     Float                  @default(0)
  taxRate            Float                  @default(0)
  taxAmount          Float                  @default(0)
  totalAmount        Float                  @default(0)
  notes              String?                @db.Text
  terms              String?                @db.Text
  amcPackages        String?                @db.Text
  isDigitallySigned  Boolean                @default(false)
  signedAt           DateTime?
  signedBy           String?
  convertedInvoiceId String?
  isDeleted          Boolean                @default(false)
  deletedAt          DateTime?
  createdBy          String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  items              QuotationItem[]
  revisions          QuotationRevision[]
  negotiations       QuotationNegotiation[]
  invoices           Invoice[]
  projects           Project[]

  @@index([quotationNumber])
  @@index([clientId, status])
  @@index([quotationDate])
  @@index([isDeleted])
}

model QuotationItem {
  id              String    @id @default(uuid())
  quotationId     String
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  itemOrder       Int       @default(0)
  title           String?
  description     String
  quantity        Float     @default(1)
  unitPrice       Float     @default(0)
  discountPercent Float     @default(0)
  discountType    String?   @default("PERCENTAGE")
  discountAmount  Float?    @default(0)
  taxPercent      Float     @default(0)
  totalPrice      Float     @default(0)

  @@index([quotationId])
}

model QuotationRevision {
  id             String    @id @default(uuid())
  quotationId    String
  quotation      Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  revisionNumber Int
  revisedAt      DateTime  @default(now())
  revisedBy      String?
  reason         String?
  snapshot       String    @db.Text // Full JSON snapshot of previous quotation state

  @@index([quotationId])
}

model QuotationNegotiation {
  id             String    @id @default(uuid())
  quotationId    String
  quotation      Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  round          Int       @default(1)
  proposedBy     String    // CLIENT or COMPANY
  personName     String
  previousAmount Float
  offeredAmount  Float
  changeAmount   Float
  reason         String?
  notes          String?   @db.Text
  status         String    @default("PENDING") // PENDING, ACCEPTED, REJECTED, COUNTER_OFFERED
  createdAt      DateTime  @default(now())

  @@index([quotationId])
}

model Invoice {
  id                String        @id @default(uuid())
  invoiceNumber     String        @unique
  clientId          String
  client            Client        @relation(fields: [clientId], references: [id])
  quotationId       String?
  quotation         Quotation?    @relation(fields: [quotationId], references: [id])
  invoiceDate       DateTime      @default(now())
  dueDate           DateTime
  status            InvoiceStatus @default(DRAFT)
  subtotal          Float         @default(0)
  discountAmount    Float         @default(0)
  taxAmount         Float         @default(0)
  totalAmount       Float         @default(0)
  paidAmount        Float         @default(0)
  balanceDue        Float         @default(0)
  notes             String?       @db.Text
  terms             String?       @db.Text
  isDigitallySigned Boolean       @default(false)
  signedAt          DateTime?
  signedBy          String?
  isDeleted         Boolean       @default(false)
  deletedAt         DateTime?
  createdBy         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  items             InvoiceItem[]
  payments          Payment[]
  projectId         String?
  project           Project?      @relation(fields: [projectId], references: [id])
  milestoneId       String?

  @@index([invoiceNumber])
  @@index([clientId, status])
  @@index([invoiceDate])
  @@index([dueDate])
  @@index([projectId])
  @@index([isDeleted])
}

model InvoiceItem {
  id              String   @id @default(uuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemOrder       Int      @default(0)
  title           String?
  description     String
  quantity        Float    @default(1)
  unitPrice       Float    @default(0)
  discountPercent Float    @default(0)
  discountType    String?  @default("PERCENTAGE")
  discountAmount  Float?   @default(0)
  taxPercent      Float    @default(0)
  totalPrice      Float    @default(0)

  @@index([invoiceId])
}

model Payment {
  id                String      @id @default(uuid())
  receiptNumber     String      @unique
  invoiceId         String?
  invoice           Invoice?    @relation(fields: [invoiceId], references: [id])
  clientId          String
  client            Client      @relation(fields: [clientId], references: [id])
  paymentType       PaymentType @default(PARTIAL)
  amount            Float       @default(0)
  paymentDate       DateTime    @default(now())
  paymentMode       PaymentMode @default(BANK_TRANSFER)
  referenceNumber   String?     // Cheque / UTR / Transaction ID
  bankAccount       String?
  notes             String?     @db.Text
  receiptUrl        String?
  projectId         String?
  project           Project?    @relation(fields: [projectId], references: [id])
  milestoneId       String?
  splits            PaymentSplit[]
  isDigitallySigned Boolean     @default(false)
  signedAt          DateTime?
  signedBy          String?
  createdBy         String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([receiptNumber])
  @@index([invoiceId])
  @@index([clientId])
  @@index([projectId])
  @@index([paymentDate])
}

model Vendor {
  id            String    @id @default(uuid())
  vendorCode    String    @unique
  vendorName    String
  company       String?
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  gstNumber     String?
  panNumber     String?
  bankDetails   String?   @db.Text
  totalPayable  Float     @default(0)
  totalPaid     Float     @default(0)
  outstanding   Float     @default(0)
  status        String    @default("ACTIVE")
  notes         String?   @db.Text
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  expenses      Expense[]

  @@index([vendorCode])
  @@index([vendorName])
  @@index([isDeleted])
}

model Expense {
  id              String      @id @default(uuid())
  expenseCode     String      @unique
  category        String      // Office Rent, Salary, Hosting, Cloud, Marketing, etc.
  amount          Float
  expenseDate     DateTime    @default(now())
  paymentMode     PaymentMode @default(BANK_TRANSFER)
  vendorId        String?
  vendor          Vendor?     @relation(fields: [vendorId], references: [id])
  description     String
  referenceNumber String?
  receiptUrl      String?
  projectId       String?
  project         Project?    @relation(fields: [projectId], references: [id])
  isReimbursable  Boolean     @default(false)
  employeeName    String?
  reimbursementStatus String? @default("N_A") // N_A, PENDING, APPROVED, REIMBURSED
  approvalStatus  String      @default("APPROVED") // PENDING, APPROVED, REJECTED
  approvedBy      String?
  approvedAt      DateTime?
  accountId       String?
  notes           String?     @db.Text
  isDeleted       Boolean     @default(false)
  deletedAt       DateTime?
  createdBy       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([expenseCode])
  @@index([category])
  @@index([expenseDate])
  @@index([vendorId])
  @@index([projectId])
  @@index([isDeleted])
}

model DocumentTemplate {
  id              String   @id @default(uuid())
  type            String   // QUOTATION, INVOICE, RECEIPT
  name            String
  headerText      String?
  footerText      String?
  termsText       String?  @db.Text
  primaryColor    String   @default("#1e40af")
  accentColor     String   @default("#3b82f6")
  showLogo        Boolean  @default(true)
  showBankDetails Boolean  @default(true)
  showSignature   Boolean  @default(true)
  showSeal        Boolean  @default(true)
  isDefault       Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  @@index([type])
}

model NumberingConfig {
  id                String   @id @default(uuid())
  documentType      String   @unique // QUOTATION, INVOICE, PAYMENT, EXPENSE, CLIENT, VENDOR
  prefix            String
  includeFiscalYear Boolean  @default(true)
  currentSequence   Int      @default(1)
  padLength         Int      @default(4)
  updatedAt         DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail  String?
  module     String   // AUTH, CLIENT, QUOTATION, INVOICE, PAYMENT, EXPENSE, VENDOR, SETTINGS
  action     String   // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, SIGN, CONVERT, NEGOTIATE, SETTINGS_CHANGE
  entityId   String?
  entityType String?
  ipAddress  String?
  details    String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([module])
  @@index([action])
  @@index([createdAt])
  @@index([userId])
}

model Project {
  id                     String             @id @default(uuid())
  projectCode            String             @unique
  name                   String
  description            String?            @db.Text
  clientId               String
  client                 Client             @relation(fields: [clientId], references: [id])
  quotationId            String?
  quotation              Quotation?         @relation(fields: [quotationId], references: [id])
  status                 String             @default("PLANNING") // PLANNING, IN_PROGRESS, ON_HOLD, COMPLETED, HANDED_OVER, CANCELLED
  startDate              DateTime?
  deadline               DateTime?
  completedDate          DateTime?
  quotationValue         Float              @default(0)
  additionalCharges      Float              @default(0)
  totalProjectValue      Float              @default(0)
  advanceRequiredPercent Float              @default(50)
  advanceRequiredAmount  Float              @default(0)
  advanceReceived        Float              @default(0)
  assignedTeam           String?            @db.Text // JSON string: [{name, role, email}]
  handoverStatus         String             @default("NOT_READY") // NOT_READY, PENDING_CLEARANCE, CLEARED, HANDED_OVER
  handoverDate           DateTime?
  handoverApprovedBy     String?
  handoverNotes          String?            @db.Text
  isDeleted              Boolean            @default(false)
  deletedAt              DateTime?
  createdBy              String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  milestones             ProjectMilestone[]
  payments               Payment[]
  expenses               Expense[]
  invoices               Invoice[]

  @@index([projectCode])
  @@index([clientId])
  @@index([status])
  @@index([handoverStatus])
  @@index([isDeleted])
}

model ProjectMilestone {
  id             String    @id @default(uuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  milestoneOrder Int       @default(0)
  percentage     Float     @default(0)
  amount         Float     @default(0)
  dueDate        DateTime?
  status         String    @default("PENDING") // PENDING, INVOICED, PARTIALLY_PAID, PAID, OVERDUE
  paidAmount     Float     @default(0)
  notes          String?   @db.Text
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([projectId])
  @@index([status])
}

model PaymentSplit {
  id              String      @id @default(uuid())
  paymentId       String
  payment         Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentMode     PaymentMode @default(CASH)
  amount          Float
  accountId       String?
  accountName     String?
  referenceNumber String?
  notes           String?
  createdAt       DateTime    @default(now())

  @@index([paymentId])
  @@index([accountId])
}

model FinancialAccount {
  id             String               @id @default(uuid())
  accountCode    String               @unique // ACC-CASH, ACC-GPAY, ACC-HDFC, etc.
  accountName    String               // Cash in Hand, Google Pay (Business), HDFC Current A/C
  accountType    String               // CASH, UPI, BANK
  bankName       String?
  accountNumber  String?
  ifscCode       String?
  openingBalance Float                @default(0)
  currentBalance Float                @default(0)
  isDefault      Boolean              @default(false)
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  transactions   AccountTransaction[]

  @@index([accountCode])
  @@index([accountType])
}

model AccountTransaction {
  id              String           @id @default(uuid())
  accountId       String
  account         FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactionType String           // CREDIT, DEBIT, TRANSFER_IN, TRANSFER_OUT
  amount          Float
  balanceAfter    Float
  category        String           // PAYMENT_RECEIVED, EXPENSE_PAID, INTERNAL_TRANSFER, REIMBURSEMENT
  referenceId     String?
  referenceNumber String?
  description     String
  transactionDate DateTime         @default(now())
  createdAt       DateTime         @default(now())

  @@index([accountId])
  @@index([transactionType])
  @@index([transactionDate])
}

model DemoLead {
  id               String    @id @default(uuid())
  fullName         String
  companyName      String
  email            String
  phone            String
  whatsappNumber   String?
  industry         String?
  companySize      String?
  monthlyProjects  String?
  currentProcess   String?
  featuresInterest String?   @db.Text
  preferredDate    String?
  preferredTime    String?
  additionalReqs   String?   @db.Text
  consentContact   Boolean   @default(true)
  status           String    @default("NEW") // NEW, CONTACTED, DEMO_SCHEDULED, DEMO_COMPLETED, FOLLOW_UP, CONVERTED, CLOSED
  assignedTo       String?
  notes            String?   @db.Text
  followUpDate     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

